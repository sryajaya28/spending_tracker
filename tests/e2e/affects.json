{
 "_about": "Rules for tools/affected_tests.js. A rule fires when a changed file path matches one of `files` (regex) or a changed line of an app file matches one of `diff` (regex, case-insensitive). `tests` are run_all.sh test names. Keep the rules broad rather than clever: a missed test costs more than an extra one. `node tools/affected_tests.js --verify` checks them against the repo history.",
 "always": [
  "run",
  "sample",
  "onboarding"
 ],
 "fullSuiteFiles": [
  "^prototype/(cloud|config|index)\\.(js|html)$",
  "^prototype/sw\\.js$",
  "^api/",
  "^vercel\\.json$",
  "^supabase/",
  "^package",
  "^tests/e2e/fake_supabase\\.js$"
 ],
